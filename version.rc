#define COMPUTER_WATCH_VERSION "V0.1.0002"

1 VERSIONINFO
FILEVERSION 0,1,2,0
PRODUCTVERSION 0,1,2,0
FILEOS 0x00040004
FILETYPE 0x00000001
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Computer Watch"
            VALUE "FileVersion", COMPUTER_WATCH_VERSION
            VALUE "ProductName", "Computer Watch"
            VALUE "ProductVersion", COMPUTER_WATCH_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
